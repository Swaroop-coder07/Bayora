# Copy to .env and edit.
SECRET_KEY=replace-with-a-long-random-string
LLM_PROVIDER=mock                # mock (offline demo model) | anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
DOCKER_ENABLED=false             # true = one `docker run --rm` container per test
SANDBOX_IMAGE=bayora-backend
SIMILARITY_THRESHOLD=0.6
LEAKAGE_BUDGET_TOTAL=5
LEAKAGE_WINDOW_MINUTES=60
SEED_BLUE_PASSWORD=blue123       # development seed users - change before any real use
SEED_RED_PASSWORD=red123
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
